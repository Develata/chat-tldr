# 本地开发密钥模板：复制为 .env 后填入真实值；不要在本文件中保存密钥。
# .env 与 .env.* 本地变体已被 Git 忽略，只有 .env.example 可以提交。
# 当前 CLI 不会自动加载 .env；可用下面的 PowerShell 包装脚本为子进程加载：
# ./scripts/with-env.ps1 cargo run -p chat-tldr -- doctor
# 语法、变量优先级及运行说明见 docs/ENVIRONMENT.md。
# 配置中 api_key_env 指定的是下面的变量名，不是密钥本身。

# Jev / TypeSafe；留空时分析使用 LLM Decider。
TYPESAFE_API_KEY=

# DeepSeek；实际分析必需，离线导入、查询和 --dry-run 不需要。
CHAT_TLDR_LLM_API_KEY=

# 当前主线尚未实现 embedding；无需设置相关密钥。
